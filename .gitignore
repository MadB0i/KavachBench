# Raw benchmark outputs (large, regenerable)
results/*/
!results/.gitkeep
# Keep the verified VM run available for reproducing on another device.
!results/2026-09-10-vm/
!results/2026-09-10-vm/*

# Kavach build artifacts if vendored
target/
Cargo.lock

# OS / editor
.DS_Store
Thumbs.db
__MACOSX/
.vscode/
.idea/
System Volume Information/

# Python bytecode caches
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/

# Secrets, credentials, and local agent/CLI config
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.pfx
*.p12
*credentials*.json
host-creds-*.json
secrets.*
.claude/settings.local.json
.opencode/auth.json
